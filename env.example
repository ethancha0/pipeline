# applypipe settings — copy to ~/.applypipe/.env (or $APPLYPIPE_HOME/.env) and fill in.
# Placeholders only. Never commit your real .env.

# Bot token from the Discord developer portal (Bot → Reset Token). Required.
DISCORD_TOKEN=your-discord-bot-token
# ID of the #jobs channel the webhook posts to (Developer Mode → right-click → Copy Channel ID). Required.
DISCORD_CHANNEL_ID=000000000000000000
# Your own Discord user ID; only this user's ✅ queues a job. Required.
DISCORD_OWNER_ID=000000000000000000

# Claude API key, needed from Phase 7 (answer brain). Optional until then.
ANTHROPIC_API_KEY=
# Claude model used for answers and matching tie-breaks.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Max jobs filling at once (parked tabs don't count). Default 3.
MAX_PARALLEL=3
# How far back startup catch-up scans the channel, in days (also capped at 500 messages). Default 14.
CATCHUP_DAYS=14
# Claude answers below this confidence (0–1) are highlighted yellow. Default 0.7.
LLM_CONFIDENCE_FLAG=0.7
